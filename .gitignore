# Julia environments (resolved from Project.toml [compat] by each user)
Manifest*.toml

# Machine-specific preferences (e.g. path of the PhreeqcRM library)
LocalPreferences.toml

# Coverage and allocation tracking
*.jl.cov
*.jl.*.cov
*.jl.mem
*.jl.*.mem
lcov.info

# Documentation build (Documenter.jl, DocumenterVitepress.jl), pages generated from the
# examples, and Node.js packages of VitePress
docs/build/
docs/src/examples/
docs/node_modules/
docs/package-lock.json

# Log file written by PhreeqcRM in the working directory
phreeqc.log

# Output of the examples (figures)
examples/output/

# Visual Studio Code
.vscode/

# Misc
private/
CLAUDE.md
